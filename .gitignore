# Private data, old reports and temporary outputs stay outside version control.
/local/
/FröttmaningFreimann/scene/raw/
/FröttmaningFreimann/scene/rebuild/
.venv*/
__pycache__/
*.py[cod]
.DS_Store
*.qgz~
*.gpkg-wal
*.gpkg-shm
/FröttmaningFreimann/runs/
/docs/
/tmp/
# OpenFOAM generated outputs (regenerate with DLR/windCase/Allrun.noturbine)
/DLR/windCase/*.stl
/DLR/windCase/constant/polyMesh/
/DLR/windCase/constant/triSurface/
/DLR/windCase/constant/extendedFeatureEdgeMesh/
/DLR/windCase/constant/fvOptions
/DLR/windCase/[0-9]*/
/DLR/windCase/log.*
/DLR/windCase/*.foam
/DLR/windCase/system/caseParams
/DLR/windCase/system/topoSetDict
!/DLR/windCase/0.orig/
/DLR/windCase/processor*/
/DLR/windCase/run.out
/DLR/windCase/postProcessing/
/DLR/meshStudy/*/
!/DLR/meshStudy/report/
/DLR/meshStudy/run.log
# Mesh study: generated cases (rebuild with DLR/meshStudy/setup.py); only scripts + results are tracked
/DLR/meshStudy/coarse/
/DLR/meshStudy/medium/
/DLR/meshStudy/fine/
/DLR/meshStudy/run_all.out
/DLR/meshStudy/site_map.npz

# Wind study: generated runs, downloads and dense sampled arrays.
/scenes/*/data/raw/
/scenes/*/runs/
/scenes/*/results/**/samples.json
/scenes/*/results/**/*.npz
/scenes/*/results/**/matched_mean_bins.csv
/scenes/review-export/.qa/

/scenes/local/

# Wind atlas: solver cases and gridded fields are large (rebuild with DLR/atlas/run_atlas.sh)
/DLR/atlas/cases.noindex/
/DLR/atlas/grid.noindex/
/DLR/atlas/run_atlas.out
.pytest_cache/
/DLR/planner/results/cache/

/DLR/atlas/*.out
/DLR/atlas/*.log
/DLR/slides/*/build.log
