FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
libs            (atmosphericModels);   // provides the atmospheric inlet/wall conditions
application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         600;                    // SIMPLE iterations, not seconds of weather
deltaT          1;
writeControl    timeStep;
writeInterval   100;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
timeFormat      general;
runTimeModifiable yes;
