FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet     { type calculated; value uniform 0; }
    outlet    { type calculated; value uniform 0; }
    "(terrain|buildings)" { type atmNutkWallFunction; z0 uniform 0.1; boundNut false; value uniform 0; }
    "(top|side|bottom)"   { type slip; }
}
